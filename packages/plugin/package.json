{
  "name": "@dshbot/plugin",
  "version": "1.0.0",
  "type": "module",
  "description": "DSHBot 的 DSH 插件：房间页面 + 多 Bot 编排",
  "license": "MIT",
  "author": "DSHBot contributors",
  "keywords": ["dsh", "deepseek-harness", "plugin", "multi-agent", "rooms", "orchestration"],
  "engines": {
    "node": ">=22"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "files": ["lib", "cordis.patch.yml", "locale", "icon.svg"],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@dshbot/core": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "esbuild": "0.28.2",
    "react": "18.3.1",
    "typescript": "5.9.3"
  }
}

