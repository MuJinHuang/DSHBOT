{
  "name": "dshbot",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "A DSH plugin that runs a room of role-based bots: plan, split work, deliver files.",
  "license": "MIT",
  "author": "DSHBot contributors",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "multi-agent",
    "rooms"
  ],
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "biome lint .",
    "test": "pnpm build && node --test tests/*.test.mjs",
    "test:coverage": "pnpm build && node --test --experimental-test-coverage --test-coverage-lines=65 --test-coverage-branches=60 --test-coverage-functions=65 tests/*.test.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "drill": "node spike/drill.mjs",
    "drill:ops": "pnpm build && node --test tests/api-members.test.mjs",
    "drill:docs": "pnpm build && node --test tests/api-files.test.mjs",
    "drill:clone": "pnpm build && node --test tests/api-reuse.test.mjs",
    "smoke:ui": "node spike/ui-smoke.mjs",
    "docs:check": "node scripts/check-doc-links.mjs",
    "docs:build": "node scripts/check-doc-links.mjs && node scripts/build-docs.mjs",
    "stage:release": "node scripts/stage-release.mjs",
    "install:profile": "node scripts/install.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "marked": "^18.2.0",
    "typescript": "5.9.3"
  }
}
