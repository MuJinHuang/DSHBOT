{
  "name": "dshbot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm build && node --test tests/*.test.mjs",
    "check": "pnpm typecheck && pnpm test",
    "drill": "node spike/drill.mjs",
    "drill:ops": "pnpm build && node --test tests/api-members.test.mjs",
    "drill:docs": "pnpm build && node --test tests/api-files.test.mjs",
    "drill:clone": "pnpm build && node --test tests/api-reuse.test.mjs",
    "install:profile": "node scripts/install.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
